<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>LLM Paper Tracker</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Daily Research Radar</p>
      <h1>LLM Efficiency Paper Tracker</h1>
      <p class="sub">Auto-collected from arXiv and OpenAlex every day at 9:00 AM KST.</p>
      <p class="meta">Generated at {{ generated_at }} | Keywords: {{ keywords|join(', ') }}</p>
    </div>
    <div class="bg-shape shape-a"></div>
    <div class="bg-shape shape-b"></div>
  </header>

  <main class="container">
    <section class="tabs" aria-label="sections">
      <button type="button" class="tab-btn active" data-tab="home">Home</button>
      <button type="button" class="tab-btn" data-tab="papers">Paper List</button>
      <button type="button" class="tab-btn" data-tab="trends">Daily Trends</button>
    </section>

    <section id="homeTab" class="tab-panel active" aria-label="home summary">
      <h2>Home</h2>
      <p id="todayCount" class="home-stat">Today added papers: 0</p>
      <p id="totalCount" class="home-stat">Total papers: 0</p>
    </section>

    <section id="papersTab" class="tab-panel" aria-label="paper list">
      <section class="controls">
        <input id="searchInput" placeholder="Search title, author, affiliation, publication venue" aria-label="search">
        <select id="categoryFilter" aria-label="category filter">
          <option value="all">All categories</option>
        </select>
        <select id="sortFilter" aria-label="sort filter">
          <option value="added_desc">Sort: Added date (Newest)</option>
          <option value="added_asc">Sort: Added date (Oldest)</option>
          <option value="title_asc">Sort: Title (A-Z)</option>
          <option value="title_desc">Sort: Title (Z-A)</option>
        </select>
      </section>

      <section class="live-search" aria-label="OpenAlex live search">
        <div class="live-search-header">
          <h2>Live OpenAlex Search</h2>
          <p>Search OpenAlex in real time and add results directly to this table. Add is restricted to authenticated users.</p>
        </div>
        <div class="auth-controls" aria-label="add authentication">
          <input id="authUserInput" placeholder="username" aria-label="username">
          <input id="authKeyInput" type="password" placeholder="access key" aria-label="access key">
          <button id="authLoginBtn" type="button">Authenticate</button>
          <button id="authLogoutBtn" type="button">Logout</button>
        </div>
        <p id="authStatus" class="auth-status"></p>
        <div class="live-search-controls">
          <input id="liveSearchInput" placeholder="e.g. quantization llm inference" aria-label="live openalex search">
        </div>
        <p id="liveSearchStatus" class="live-search-status"></p>
        <div id="liveSearchResults" class="live-search-results"></div>
      </section>

      <p id="tableMeta" class="table-meta"></p>

      <section>
        <table id="paperTable">
          <thead>
            <tr>
              <th>Read</th>
              <th>Title</th>
              <th>Added Date</th>
              <th>Authors</th>
              <th>Affiliation</th>
              <th>Publication Venue</th>
              <th>Year</th>
              <th>Category</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
            {% set paper = row.paper %}
            <tr
              data-category="{{ paper.category|join('|')|e }}"
              data-paper-id="{{ paper.paper_id|e }}"
              data-title="{{ paper.title|e }}"
              data-added-date="{{ paper.added_date|e }}"
            >
              <td><input type="checkbox" class="read-checkbox" aria-label="mark as read"></td>
              <td>
                <a
                  href="{{ row.page_file }}"
                  class="paper-title-link"
                  data-abstract="{{ (paper.abstract if paper.abstract else 'Abstract unavailable.')|e }}"
                >{{ paper.title }}</a>
              </td>
              <td>{{ paper.added_date if paper.added_date else 'N/A' }}</td>
              <td>{{ paper.authors[:5]|join(', ') }}{% if paper.authors|length > 5 %}, ...{% endif %}</td>
              <td>{{ paper.affiliations[:3]|join(', ') if paper.affiliations else 'N/A' }}</td>
              <td>{{ paper.venue }}</td>
              <td>{{ paper.year }}</td>
              <td>{{ paper.category|join(', ') }}</td>
              <td><button type="button" class="row-delete-btn">Delete</button></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <nav id="pagination" class="pagination" aria-label="Paper pagination"></nav>
    </section>

    <section id="trendsTab" class="tab-panel" aria-label="daily trends">
      <h2>Daily Added Papers Trend</h2>
      <p class="trend-sub">Bar chart by added date in this tracker.</p>
      <div id="trendChart" class="trend-chart"></div>
    </section>
  </main>

  <script>
    const READ_KEY = "llm-paper-tracker-read-map-v1";
    const ADDED_KEY = "llm-paper-tracker-live-added-v1";
    const DELETED_KEY = "llm-paper-tracker-deleted-v1";
    const AUTH_KEY = "llm-paper-tracker-auth-v1";
    const AUTH_USERS = {
      "admin": "tracker-admin-2026",
    };
    const PAGE_SIZE = 50;
    let rows = [];
    const search = document.getElementById("searchInput");
    const category = document.getElementById("categoryFilter");
    const sortFilter = document.getElementById("sortFilter");
    const pagination = document.getElementById("pagination");
    const tableMeta = document.getElementById("tableMeta");
    const tableBody = document.querySelector("#paperTable tbody");
    const todayCount = document.getElementById("todayCount");
    const totalCount = document.getElementById("totalCount");
    const trendChart = document.getElementById("trendChart");
    const tabButtons = Array.from(document.querySelectorAll(".tab-btn"));
    const tabPanels = {
      home: document.getElementById("homeTab"),
      papers: document.getElementById("papersTab"),
      trends: document.getElementById("trendsTab"),
    };
    const serverDailyAdditions = {{ daily_additions | tojson }};
    const serverTodayAddedCount = Number({{ today_added_count }} || 0);
    const liveSearchInput = document.getElementById("liveSearchInput");
    const liveSearchStatus = document.getElementById("liveSearchStatus");
    const liveSearchResults = document.getElementById("liveSearchResults");
    const authUserInput = document.getElementById("authUserInput");
    const authKeyInput = document.getElementById("authKeyInput");
    const authLoginBtn = document.getElementById("authLoginBtn");
    const authLogoutBtn = document.getElementById("authLogoutBtn");
    const authStatus = document.getElementById("authStatus");
    let currentPage = 1;
    let isAuthenticated = false;
    let liveSearchTimer = null;
    let liveSearchAbortController = null;
    let liveSearchRequestSeq = 0;

    const abstractPreview = document.createElement("div");
    abstractPreview.id = "abstractPreview";
    abstractPreview.className = "abstract-preview";
    abstractPreview.hidden = true;
    document.body.appendChild(abstractPreview);

    function positionPreview(event) {
      const offset = 16;
      const maxLeft = window.innerWidth - abstractPreview.offsetWidth - 12;
      const left = Math.min(event.clientX + offset, Math.max(12, maxLeft));
      const top = Math.min(event.clientY + offset, window.innerHeight - abstractPreview.offsetHeight - 12);
      abstractPreview.style.left = `${left}px`;
      abstractPreview.style.top = `${top}px`;
    }

    function showPreview(link, event) {
      const text = (link.dataset.abstract || "").trim() || "Abstract unavailable.";
      abstractPreview.textContent = text;
      abstractPreview.hidden = false;
      positionPreview(event);
    }

    function hidePreview() {
      abstractPreview.hidden = true;
    }

    function attachPreviewEvents(link) {
      link.addEventListener("mouseenter", (event) => showPreview(link, event));
      link.addEventListener("mousemove", positionPreview);
      link.addEventListener("mouseleave", hidePreview);
      link.addEventListener("focus", (event) => showPreview(link, event));
      link.addEventListener("blur", hidePreview);
    }

    function loadReadMap() {
      try {
        return JSON.parse(localStorage.getItem(READ_KEY) || "{}");
      } catch (error) {
        return {};
      }
    }

    function saveReadMap(map) {
      localStorage.setItem(READ_KEY, JSON.stringify(map));
    }

    function loadAddedPapers() {
      try {
        return JSON.parse(localStorage.getItem(ADDED_KEY) || "[]");
      } catch (error) {
        return [];
      }
    }

    function loadDeletedSet() {
      try {
        return new Set(JSON.parse(localStorage.getItem(DELETED_KEY) || "[]"));
      } catch (error) {
        return new Set();
      }
    }

    function saveDeletedSet(set) {
      localStorage.setItem(DELETED_KEY, JSON.stringify(Array.from(set)));
    }

    function loadAuthState() {
      try {
        return localStorage.getItem(AUTH_KEY) === "1";
      } catch (error) {
        return false;
      }
    }

    function saveAuthState(value) {
      localStorage.setItem(AUTH_KEY, value ? "1" : "0");
    }

    function saveAddedPapers() {
      const addedRows = rows.filter((row) => row.dataset.isLiveAdded === "1");
      const payload = addedRows.map((row) => ({
        paper_id: row.dataset.paperId,
        title: row.dataset.title || "",
        authors: (row.dataset.authors || "").split("||").filter(Boolean),
        affiliations: (row.dataset.affiliations || "").split("||").filter(Boolean),
        venue: row.dataset.venue || "N/A",
        year: Number(row.dataset.year || 0),
        category: (row.dataset.category || "").split("|").filter(Boolean),
        added_date: row.dataset.addedDate || "",
        published_date: row.dataset.addedDate || "",
        abstract: row.dataset.abstract || "",
        url: row.dataset.url || "",
      }));
      localStorage.setItem(ADDED_KEY, JSON.stringify(payload));
    }

    const readMap = loadReadMap();
    const deletedSet = loadDeletedSet();
    isAuthenticated = loadAuthState();

    function updateAuthUI() {
      authStatus.textContent = isAuthenticated
        ? "Authenticated. You can add OpenAlex papers."
        : "Not authenticated. Add is disabled.";
      authStatus.classList.toggle("ok", isAuthenticated);
      authStatus.classList.toggle("warn", !isAuthenticated);
    }

    function removeRowById(paperId, persistDelete) {
      const row = rows.find((r) => r.dataset.paperId === paperId);
      if (!row) return;
      row.remove();
      rows = rows.filter((r) => r.dataset.paperId !== paperId);
      delete readMap[paperId];
      saveReadMap(readMap);
      if (row.dataset.isLiveAdded === "1") {
        saveAddedPapers();
      }
      if (persistDelete) {
        deletedSet.add(paperId);
        saveDeletedSet(deletedSet);
      }
      updateCategoryOptions();
      applyFilter();
    }

    function registerRow(row) {
      if (rows.includes(row)) return;
      if (deletedSet.has(row.dataset.paperId)) {
        row.remove();
        return;
      }
      row.dataset.title = row.dataset.title || (row.querySelector(".paper-title-link")?.textContent || "").trim();
      row.dataset.addedDate = dateToKey(row.dataset.addedDate) === "0000-00-00"
        ? todayKstKey()
        : row.dataset.addedDate;
      rows.push(row);
      const paperId = row.dataset.paperId;
      const checkbox = row.querySelector(".read-checkbox");
      const isRead = Boolean(readMap[paperId]);
      checkbox.checked = isRead;
      row.classList.toggle("read-row", isRead);

      const titleLink = row.querySelector(".paper-title-link");
      if (titleLink) {
        attachPreviewEvents(titleLink);
      }

      checkbox.addEventListener("change", () => {
        readMap[paperId] = checkbox.checked;
        row.classList.toggle("read-row", checkbox.checked);
        saveReadMap(readMap);
      });

      const deleteBtn = row.querySelector(".row-delete-btn");
      if (deleteBtn) {
        deleteBtn.addEventListener("click", () => {
          removeRowById(paperId, true);
        });
      }
    }

    function updateCategoryOptions() {
      const selected = category.value;
      category.innerHTML = "";
      const allOption = document.createElement("option");
      allOption.value = "all";
      allOption.textContent = "All categories";
      category.appendChild(allOption);

      const categorySet = new Set();
      rows.forEach((row) => {
        row.dataset.category.split("|").forEach((c) => {
          const trimmed = c.trim();
          if (trimmed) categorySet.add(trimmed);
        });
      });

      [...categorySet].sort().forEach((c) => {
        const option = document.createElement("option");
        option.value = c;
        option.textContent = c;
        category.appendChild(option);
      });

      if ([...category.options].some((o) => o.value === selected)) {
        category.value = selected;
      } else {
        category.value = "all";
      }
    }

    function rowMatches(row) {
      const q = search.value.toLowerCase().trim();
      const selected = category.value;
      const textMatch = row.textContent.toLowerCase().includes(q);
      const categoryMatch = selected === "all" || row.dataset.category.includes(selected);
      return textMatch && categoryMatch;
    }

    function dateToKey(rawDate) {
      const normalized = String(rawDate || "").trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(normalized)) return "0000-00-00";
      return normalized;
    }

    function todayKstKey() {
      const now = new Date();
      const utcMillis = now.getTime() + (now.getTimezoneOffset() * 60000);
      const kstMillis = utcMillis + (9 * 60 * 60 * 1000);
      return new Date(kstMillis).toISOString().slice(0, 10);
    }

    function dateToTimestamp(rawDate) {
      const key = dateToKey(rawDate);
      if (key === "0000-00-00") return Number.NEGATIVE_INFINITY;
      const value = Date.parse(`${key}T00:00:00Z`);
      return Number.isNaN(value) ? Number.NEGATIVE_INFINITY : value;
    }

    function sortRows(inputRows) {
      const mode = sortFilter.value;
      const sorted = [...inputRows];
      sorted.sort((a, b) => {
        if (mode === "title_asc" || mode === "title_desc") {
          const left = (a.dataset.title || "").toLowerCase();
          const right = (b.dataset.title || "").toLowerCase();
          const cmp = left.localeCompare(right);
          return mode === "title_asc" ? cmp : -cmp;
        }

        const leftDate = dateToTimestamp(a.dataset.addedDate);
        const rightDate = dateToTimestamp(b.dataset.addedDate);
        if (leftDate === rightDate) {
          const leftTitle = (a.dataset.title || "").toLowerCase();
          const rightTitle = (b.dataset.title || "").toLowerCase();
          return leftTitle.localeCompare(rightTitle);
        }
        return mode === "added_asc" ? leftDate - rightDate : rightDate - leftDate;
      });
      return sorted;
    }

    function getDateCounts() {
      const entries = Object.entries(serverDailyAdditions || {})
        .map(([date, count]) => [dateToKey(date), Number(count || 0)])
        .filter(([date, count]) => date !== "0000-00-00" && count > 0)
        .sort(([a], [b]) => a.localeCompare(b));

      if (entries.length) {
        return entries;
      }

      // Fallback when history file is unavailable.
      const fallbackCounts = new Map();
      rows.forEach((row) => {
        const date = dateToKey(row.dataset.addedDate);
        if (date === "0000-00-00") return;
        fallbackCounts.set(date, (fallbackCounts.get(date) || 0) + 1);
      });
      return Array.from(fallbackCounts.entries()).sort(([a], [b]) => a.localeCompare(b));
    }

    function renderTrendChart() {
      trendChart.innerHTML = "";
      const points = getDateCounts();
      if (!points.length) {
        trendChart.textContent = "No date data available.";
        return;
      }
      const maxCount = Math.max(...points.map(([, count]) => count), 1);
      points.forEach(([date, count]) => {
        const item = document.createElement("div");
        item.className = "trend-item";

        const label = document.createElement("span");
        label.className = "trend-label";
        label.textContent = date;

        const barWrap = document.createElement("div");
        barWrap.className = "trend-bar-wrap";

        const bar = document.createElement("div");
        bar.className = "trend-bar";
        bar.style.height = `${Math.max(8, Math.round((count / maxCount) * 180))}px`;
        bar.title = `${date}: ${count}`;

        const value = document.createElement("span");
        value.className = "trend-value";
        value.textContent = String(count);

        barWrap.appendChild(bar);
        item.appendChild(value);
        item.appendChild(barWrap);
        item.appendChild(label);
        trendChart.appendChild(item);
      });
    }

    function updateHomeStats() {
      todayCount.textContent = `Today added papers: ${serverTodayAddedCount}`;
      totalCount.textContent = `Total papers: ${rows.length}`;
    }

    function switchTab(name) {
      tabButtons.forEach((button) => {
        button.classList.toggle("active", button.dataset.tab === name);
      });
      Object.entries(tabPanels).forEach(([key, panel]) => {
        panel.classList.toggle("active", key === name);
      });
      if (name === "trends") {
        renderTrendChart();
      }
      if (name === "home") {
        updateHomeStats();
      }
    }

    function renderPagination(totalPages) {
      pagination.innerHTML = "";
      if (totalPages <= 1) return;

      const prev = document.createElement("button");
      prev.type = "button";
      prev.textContent = "Prev";
      prev.disabled = currentPage === 1;
      prev.addEventListener("click", () => {
        currentPage -= 1;
        applyFilter();
      });
      pagination.appendChild(prev);

      for (let i = 1; i <= totalPages; i += 1) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(i);
        if (i === currentPage) {
          button.classList.add("active");
        }
        button.addEventListener("click", () => {
          currentPage = i;
          applyFilter();
        });
        pagination.appendChild(button);
      }

      const next = document.createElement("button");
      next.type = "button";
      next.textContent = "Next";
      next.disabled = currentPage === totalPages;
      next.addEventListener("click", () => {
        currentPage += 1;
        applyFilter();
      });
      pagination.appendChild(next);
    }

    function applyFilter() {
      const visibleRows = sortRows(rows.filter(rowMatches));
      const totalPages = Math.max(1, Math.ceil(visibleRows.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      rows.forEach((row) => {
        row.style.display = "none";
      });

      visibleRows.forEach((row) => {
        tableBody.appendChild(row);
      });

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      visibleRows.slice(start, end).forEach((row) => {
        row.style.display = "";
      });

      tableMeta.textContent = `Showing ${visibleRows.length === 0 ? 0 : start + 1}-${Math.min(end, visibleRows.length)} of ${visibleRows.length} filtered papers`;

      renderPagination(totalPages);
      updateHomeStats();
      renderTrendChart();
    }

    function decodeOpenAlexAbstract(invertedIndex) {
      if (!invertedIndex || typeof invertedIndex !== "object") return "";
      let maxPos = -1;
      Object.values(invertedIndex).forEach((positions) => {
        if (!Array.isArray(positions)) return;
        positions.forEach((pos) => {
          if (Number.isInteger(pos) && pos > maxPos) maxPos = pos;
        });
      });
      if (maxPos < 0) return "";
      const tokens = new Array(maxPos + 1).fill("");
      Object.entries(invertedIndex).forEach(([token, positions]) => {
        if (!Array.isArray(positions)) return;
        positions.forEach((pos) => {
          if (Number.isInteger(pos) && pos >= 0 && pos < tokens.length) {
            tokens[pos] = token;
          }
        });
      });
      return tokens.filter(Boolean).join(" ");
    }

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function inferCategories(text) {
      const hay = text.toLowerCase();
      const rules = [
        ["MoE", /\bmoe\b|mixture[-\s]of[-\s]experts/],
        ["KV Cache Compression", /kv\s*cache|cache\s*compression|cache\s*eviction/],
        ["Quantization", /quantiz|low[-\s]?bit|int4|int8|fp8|gptq|awq/],
        ["Efficient Attention", /flashattention|linear\s+attention|sparse\s+attention/],
        ["Long Context", /long\s+context|context\s+window|rope|position\s+interpolation/],
        ["Distillation", /distill/],
        ["Inference Optimization", /inference|latency|throughput|serving/],
      ];
      const hits = rules.filter(([_, pattern]) => pattern.test(hay)).map(([name]) => name);
      return hits.length ? hits : ["General"];
    }

    function canonicalizeVenue(venue) {
      const value = (venue || "").trim();
      const lowered = value.toLowerCase();
      if (lowered.includes("international conference on machine learning") || lowered === "icml") return "ICML";
      if (lowered.includes("neural information processing systems") || lowered.includes("neurips")) return "NeurIPS";
      if (lowered.includes("international conference on learning representations") || lowered === "iclr") return "ICLR";
      if (lowered.includes("arxiv")) return "Preprint (arXiv)";
      return value || "OpenAlex Indexed Venue";
    }

    function buildPaperFromOpenAlex(item) {
      const id = String(item.id || "").split("/").pop() || `live-${Date.now()}`;
      const authorships = Array.isArray(item.authorships) ? item.authorships : [];
      const authors = [];
      const affSet = new Set();
      authorships.forEach((authorship) => {
        const name = authorship && authorship.author && authorship.author.display_name;
        if (name) authors.push(name);
        const institutions = Array.isArray(authorship && authorship.institutions) ? authorship.institutions : [];
        institutions.forEach((inst) => {
          if (inst && inst.display_name) affSet.add(inst.display_name);
        });
      });

      const abstract = decodeOpenAlexAbstract(item.abstract_inverted_index);
      const title = String(item.display_name || "").trim();
      const location = item.primary_location || {};
      const source = location.source || {};
      const venue = canonicalizeVenue(source.display_name || "");
      const category = inferCategories(`${title} ${abstract}`);

      return {
        paper_id: `openalex-live-${id}`,
        title,
        authors,
        affiliations: Array.from(affSet),
        venue,
        year: Number(item.publication_year || 0),
        published_date: String(item.publication_date || ""),
        added_date: todayKstKey(),
        category,
        abstract,
        url: String(item.id || location.landing_page_url || ""),
      };
    }

    function createRowElement(paper, isLiveAdded) {
      const tr = document.createElement("tr");
      tr.dataset.paperId = paper.paper_id;
      tr.dataset.category = (paper.category || []).join("|");
      tr.dataset.isLiveAdded = isLiveAdded ? "1" : "0";
      tr.dataset.title = paper.title || "";
      tr.dataset.authors = (paper.authors || []).join("||");
      tr.dataset.affiliations = (paper.affiliations || []).join("||");
      tr.dataset.venue = paper.venue || "N/A";
      tr.dataset.year = String(paper.year || 0);
      tr.dataset.addedDate = String(paper.added_date || paper.published_date || "").trim() || todayKstKey();
      tr.dataset.abstract = paper.abstract || "";
      tr.dataset.url = paper.url || "";

      const authorsShort = (paper.authors || []).slice(0, 5).join(", ");
      const authorsCell = (paper.authors || []).length > 5 ? `${authorsShort}, ...` : (authorsShort || "N/A");
      const affCell = (paper.affiliations || []).slice(0, 3).join(", ") || "N/A";

      const href = isLiveAdded ? (paper.url || "#") : (paper.page_file || "#");
      const target = isLiveAdded ? " target=\"_blank\" rel=\"noopener noreferrer\"" : "";

      tr.innerHTML = `
        <td><input type="checkbox" class="read-checkbox" aria-label="mark as read"></td>
        <td><a href="${escapeHtml(href)}" class="paper-title-link" data-abstract="${escapeHtml(paper.abstract || "")}"${target}>${escapeHtml(paper.title || "Untitled")}</a></td>
        <td>${escapeHtml(tr.dataset.addedDate || "N/A")}</td>
        <td>${escapeHtml(authorsCell)}</td>
        <td>${escapeHtml(affCell)}</td>
        <td>${escapeHtml(paper.venue || "N/A")}</td>
        <td>${escapeHtml(paper.year || 0)}</td>
        <td>${escapeHtml((paper.category || []).join(", "))}</td>
        <td><button type="button" class="row-delete-btn">Delete</button></td>
      `;
      return tr;
    }

    function addPaperToTable(paper, persist) {
      const exists = rows.some((row) => row.dataset.paperId === paper.paper_id);
      if (exists) return false;
      const row = createRowElement(paper, true);
      tableBody.prepend(row);
      registerRow(row);
      updateCategoryOptions();
      applyFilter();
      if (persist) saveAddedPapers();
      return true;
    }

    function renderLiveResults(records) {
      liveSearchResults.innerHTML = "";
      if (!records.length) {
        liveSearchStatus.textContent = "No results found.";
        return;
      }

      liveSearchStatus.textContent = `Found ${records.length} results.`;
      records.forEach((record, idx) => {
        const card = document.createElement("article");
        card.className = "live-result-card";
        card.innerHTML = `
          <h3>${escapeHtml(record.title || "Untitled")}</h3>
          <p>${escapeHtml(record.venue || "N/A")} | ${escapeHtml(record.year || "N/A")}</p>
          <p class="live-result-meta">${escapeHtml((record.authors || []).slice(0, 4).join(", ") || "Author info unavailable")}</p>
          <button type="button" data-idx="${idx}">Add</button>
        `;
        const button = card.querySelector("button");
        button.addEventListener("click", () => {
          if (!isAuthenticated) {
            liveSearchStatus.textContent = "Authentication required to add papers.";
            return;
          }
          const added = addPaperToTable(record, true);
          button.disabled = true;
          button.textContent = added ? "Added" : "Already added";
        });
        liveSearchResults.appendChild(card);
      });
    }

    async function performLiveSearch() {
      const query = liveSearchInput.value.trim();
      if (query.length < 2) {
        if (liveSearchAbortController) {
          liveSearchAbortController.abort();
          liveSearchAbortController = null;
        }
        liveSearchStatus.textContent = "Type at least 2 characters to search.";
        liveSearchResults.innerHTML = "";
        return;
      }

      const requestSeq = ++liveSearchRequestSeq;
      if (liveSearchAbortController) {
        liveSearchAbortController.abort();
      }
      liveSearchAbortController = new AbortController();

      liveSearchStatus.textContent = "Searching OpenAlex...";
      liveSearchResults.innerHTML = "";

      try {
        const params = new URLSearchParams({
          search: query,
          "per-page": "20",
          sort: "relevance_score:desc",
          filter: "from_publication_date:2025-01-01",
        });
        const response = await fetch(`https://api.openalex.org/works?${params.toString()}`, {
          signal: liveSearchAbortController.signal,
        });
        if (!response.ok) {
          throw new Error(`OpenAlex HTTP ${response.status}`);
        }
        const payload = await response.json();
        if (requestSeq !== liveSearchRequestSeq) {
          return;
        }
        const results = Array.isArray(payload.results) ? payload.results : [];
        const records = results
          .map(buildPaperFromOpenAlex)
          .filter((paper) => paper.title);
        renderLiveResults(records);
      } catch (error) {
        if (error && error.name === "AbortError") {
          return;
        }
        liveSearchStatus.textContent = `Search failed: ${error.message}`;
      }
    }

    Array.from(document.querySelectorAll("#paperTable tbody tr")).forEach(registerRow);
    updateCategoryOptions();

    loadAddedPapers().forEach((paper) => {
      addPaperToTable(paper, false);
    });

    authLoginBtn.addEventListener("click", () => {
      const user = authUserInput.value.trim();
      const key = authKeyInput.value;
      if (!user || !key) {
        authStatus.textContent = "Enter username and access key.";
        authStatus.classList.remove("ok");
        authStatus.classList.add("warn");
        return;
      }
      if (AUTH_USERS[user] && AUTH_USERS[user] === key) {
        isAuthenticated = true;
        saveAuthState(true);
        authKeyInput.value = "";
        updateAuthUI();
      } else {
        isAuthenticated = false;
        saveAuthState(false);
        authStatus.textContent = "Authentication failed.";
        authStatus.classList.remove("ok");
        authStatus.classList.add("warn");
      }
    });

    authLogoutBtn.addEventListener("click", () => {
      isAuthenticated = false;
      saveAuthState(false);
      updateAuthUI();
    });

    liveSearchInput.addEventListener("input", () => {
      if (liveSearchTimer) {
        clearTimeout(liveSearchTimer);
        liveSearchTimer = null;
      }

      const query = liveSearchInput.value.trim();
      if (query.length < 2) {
        if (liveSearchAbortController) {
          liveSearchAbortController.abort();
          liveSearchAbortController = null;
        }
        liveSearchRequestSeq += 1;
        liveSearchStatus.textContent = "Type at least 2 characters to search.";
        liveSearchResults.innerHTML = "";
        return;
      }

      liveSearchStatus.textContent = "Waiting for typing to stop...";
      liveSearchTimer = setTimeout(() => {
        performLiveSearch();
      }, 350);
    });
    liveSearchInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        if (liveSearchTimer) {
          clearTimeout(liveSearchTimer);
          liveSearchTimer = null;
        }
        performLiveSearch();
      }
    });

    search.addEventListener("input", () => {
      currentPage = 1;
      applyFilter();
    });
    category.addEventListener("change", () => {
      currentPage = 1;
      applyFilter();
    });
    sortFilter.addEventListener("change", () => {
      currentPage = 1;
      applyFilter();
    });
    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        switchTab(button.dataset.tab);
      });
    });
    updateAuthUI();
    switchTab("home");
    applyFilter();
  </script>
</body>
</html>
